# ============================================================
# 1. Python (для src/backend, src/frontend и sandbox/)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ============================================================
# 2. Секреты и локальные конфиги (КРИТИЧНО!)
# ============================================================
# Пароли к БД, токены, ключи API — никогда не коммитим!
.env
.env.local
*.secret
secrets.json
config_local.py
local_settings.py

# Если нужен шаблон для других разработчиков — коммитим только пример:
# .env.example

# ============================================================
# 3. Sandbox (эксперименты)
# ============================================================
# Всё содержимое песочницы игнорируем, но саму папку — оставляем
sandbox/*
!sandbox/.gitkeep

# Если какой-то эксперимент нужно сохранить в истории — 
# раскомментируйте и укажите конкретный путь:
# !sandbox/important-experiment.py

# Базы данных (локальные)
*.db
*.sqlite
*.sqlite3

# ============================================================
# 4. Arduino / ESP32
# ============================================================
# Arduino IDE 2.x иногда создает временные папки сборки
build/
*.elf
*.bin
*.map
*.hex
*.o
*.d
*.lst
*.sym

# Настройки пользователя в .ino файлах (иногда сохраняются IDE)
*.ino.bak
*.ino.orig

# ============================================================
# 5. PostgreSQL (если будете делать дампы)
# ============================================================
# Дампы БД не коммитим — они бинарные и большие
*.dump
*.backup
*.sql.gz

# Но schema.sql и миграции (в src/db/) — коммитим! Не игнорируйте *.sql

# ============================================================
# 6. Логи и временные файлы
# ============================================================
*.log
logs/
*.tmp
*.temp
*.swp
*.swo
*~
*.pid

# ============================================================
# 7. Экспорт данных (зависит от вашей политики)
# ============================================================
# Если выгружаете CSV/Excel из историзатора — они не нужны в Git
*.csv
*.xlsx
*.xls
# Но если хотите сохранить эталонный набор — сделайте папку data/samples/
# и раскомментируйте:
# !data/samples/*.csv

# ============================================================
# 8. IDE и редакторы
# ============================================================
# VS Code: игнорируем локальные настройки, но 
# .vscode/settings.json иногда полезен для команды — решать вам
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains (PyCharm, CLion)
.idea/
*.iml

# Eclipse / PlatformIO
.pio/
.pioenvs/
.piolibdeps/

# ============================================================
# 9. Операционные системы
# ============================================================
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS (на случай, если проект откроют на Mac)
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory
.Trash-*

# ============================================================
# 10. Сгенерированные артефакты
# ============================================================
# PNG-рендеры диаграмм (если их можно пересобрать из .mermaid)
# Оставьте закомментированным, если хотите хранить PNG в репо
# artifacts/diagrams/png/*.png

# Скомпилированные PDF/HTML из Markdown (если будете генерировать)
*.generated.pdf
*.generated.html

# ============================================================
# 11. Исключения для отчетов и документации
# ============================================================
# Принудительно разрешаем папку с логами внутри artifacts/reports/
!artifacts/reports/logs/
!artifacts/reports/logs/**